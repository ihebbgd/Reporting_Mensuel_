# Reporting Mensuel configuration
DEBUG=False
API_HOST=127.0.0.1
API_PORT=8000

# Leave empty to generate a local access key in data/access.key.
# Set a value of at least 24 characters to share the application with a small team.
API_ACCESS_KEY=

# Gemini is optional. Without this key, reports use the local synthesis.
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=30

# Comma-separated JSON array, e.g. ["https://reporting.example.tn"]
ALLOWED_ORIGINS=[]
MAX_UPLOAD_SIZE_MB=10
MAX_CSV_ROWS=20000
UPLOADS_PER_MINUTE=5
MAX_PENDING_TASKS=10
ANOMALY_THRESHOLD_PCT=30
ANOMALY_MIN_ACTIVE_MONTHS=3

